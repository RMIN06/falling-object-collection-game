#!/bin/bash
# Git hook that keeps commit messages sounding like a student wrote them.
# Install once with:  cp tools/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg
# Git passes the path of the message file as $1.

msg_file="$1"
# ignore comment lines that git adds
msg=$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d')
first=$(echo "$msg" | head -n 1)
problems=""

add () { problems="$problems\n  - $1"; }

[ -z "$first" ] && add "message is empty"
[ "$(echo "$msg" | wc -l)" -gt 1 ] && add "use a single line, no body and no trailers"
[ ${#first} -gt 60 ] && add "too long, keep it under 60 characters"
echo "$first" | grep -q ':'            && add "no colons"
echo "$first" | grep -q ';'            && add "no semicolons"
echo "$first" | grep -q -E '—|–| - '   && add "no dashes"
echo "$first" | grep -q -E '[()"`]'    && add "no brackets, quotes or backticks"
echo "$first" | grep -q -E '[.!]$'     && add "no full stop or exclamation mark at the end"
echo "$first" | grep -q -E '[A-Z]'     && add "write it all in lowercase"
echo "$first" | grep -q -i -E '^(feat|fix|chore|docs|refactor|style|test|build|ci|perf)\b' && add "no feat or fix style prefixes"
echo "$first" | grep -q -i -E '\b(implement|implemented|implements|introduce|enhance|utilize|streamline|robust|ensure|leverage|comprehensive|seamless|refactor|facilitate|optimize|functionality|improve)\b' && add "word sounds too formal, say it the way you would say it to a friend"
echo "$first" | grep -q -i -E '\b(codex|claude|gpt|openai|assistant|ai)\b' && add "do not mention tools or assistants"

if [ -n "$problems" ]; then
    echo "Commit message rejected:" >&2
    echo -e "$problems" >&2
    echo "Your message was: $first" >&2
    exit 1
fi
exit 0
